# Asset Verification Configuration
# Enable or disable the asset verification system
ASSET_VERIFICATION_ENABLED=true

# Network to use for asset verification: mainnet or testnet
ASSET_VERIFICATION_NETWORK=mainnet

# RPC / API endpoints per network
ASSET_VERIFICATION_MAINNET_RPC_URL=https://mainnet.example.com/rpc
ASSET_VERIFICATION_TESTNET_RPC_URL=https://testnet.example.com/rpc

# Optional: override the active network endpoint directly
# ASSET_VERIFICATION_RPC_URL=https://mainnet.example.com/rpc
